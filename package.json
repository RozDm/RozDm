{
  "name": "portfolio",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "predev": "node scripts/build-world-svg.mjs",
    "prebuild": "node scripts/build-world-svg.mjs",
    "build": "next build",
    "postbuild": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/finalize-export.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "npm run -s cf-typecheck && tsc --noEmit && tsc -p tsconfig.worker.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "cf-typegen": "wrangler types",
    "cf-typecheck": "WRANGLER_LOG=error wrangler types --check",
    "check:dict": "node scripts/check-dict.mjs",
    "predeploy": "npm run check",
    "deploy": "npm run build && wrangler deploy",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "prettier --check . --log-level warn && eslint . && npm run -s typecheck && vitest run --reporter=agent",
    "check:waf": "node scripts/check-waf.mjs",
    "check:csp": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-csp.mjs",
    "diagrams": "node scripts/build-diagrams.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "gray-matter": "^4.0.3",
    "highlight.js": "~11.12.0",
    "lowlight": "^3.3.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@fontsource-variable/intel-one-mono": "^5.3.0",
    "@fontsource/intel-one-mono": "^5.3.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "playwright-core": "1.65.0",
    "prettier": "3.10.1",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "vitest": "^5.1.0",
    "world-map-country-shapes": "^2.0.0",
    "wrangler": "^4.159.0"
  },
  "overrides": {
    "@tailwindcss/typography": {
      "postcss-selector-parser": "^6.1.5"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}
